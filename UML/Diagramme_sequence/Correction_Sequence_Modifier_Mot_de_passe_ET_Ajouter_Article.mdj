									},
									"font": "Arial;13;0",
									"left": 984,
									"top": 528,
									"width": 472,
									"height": 97,
									"text": "Etape 14 : Scénario d'Erreur\nCommunication impossible avec la BDD\n14.1 Afficher un message d'erreur\n14.2 Arrêt du scénario\nDans le scénario nominal, la communication est OK"
								},
								{
									"_type": "UMLTextBoxView",
									"_id": "AAAAAAGfaeTe0bVCf3k=",
									"_parent": {
